{
  "name": "btar",
  "version": "0.1.0",
  "description": "Assess and prepare Python 3.14+ brownfield repositories",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "btar": "dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/cli.ts src/index.ts --outdir dist --target bun --packages external && tsc --emitDeclarationOnly && bun scripts/make-cli-executable.ts",
    "clean": "rm -rf dist",
    "dev": "bun --watch src/cli.ts",
    "test": "bun --bun run vitest run",
    "test:coverage": "bun --bun run vitest run --coverage",
    "lint": "bun --bun run eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "verify:python": "bun run build && bun scripts/verify-python.ts"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "keywords": [
    "cli",
    "agent-ready",
    "brownfield",
    "codebase-analysis",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.13.4",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^3.0.5"
  },
  "private": true,
  "packageManager": "bun@1.4.4"
}
